{
  "name": "church-presentation-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Console d'administration et fenêtre de projection (Electron) de Church Presentation.",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "dist:win": "npm run build && node scripts/prepare-windows.mjs && electron-builder --win nsis --x64",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "org.churchpresentation.desktop",
    "productName": "Church Presentation",
    "directories": {
      "buildResources": "build-resources",
      "output": "release"
    },
    "files": [
      "build/icon.ico",
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-resources/backend",
        "to": "backend"
      },
      {
        "from": "build-resources/php",
        "to": "php"
      },
      {
        "from": "build-resources/default-media",
        "to": "default-media"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Church-Presentation-${version}-Setup.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Church Presentation",
      "deleteAppDataOnUninstall": false,
      "include": "build-resources/installer.nsh"
    }
  }
}
